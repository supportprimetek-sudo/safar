{
  "name": "safar-platform",
  "version": "1.0.0",
  "private": true,
  "description": "SAFAR - Production Full-Stack Ride-Hailing Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:api:sqlite": "npm run dev:sqlite --workspace=apps/api",
    "dev:rider": "npm run dev --workspace=apps/rider",
    "dev:driver": "npm run dev --workspace=apps/driver",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "cap:sync": "npm run build && npm run cap:sync:rider && npm run cap:sync:driver && npm run cap:sync:admin",
    "cap:sync:rider": "npm run build --workspace=apps/rider && cd apps/rider && npx cap sync android",
    "cap:sync:driver": "npm run build --workspace=apps/driver && cd apps/driver && npx cap sync android",
    "cap:sync:admin": "npm run build --workspace=apps/admin && cd apps/admin && npx cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^4.2.1",
    "sharp": "^0.35.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
